<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!-- No project references by design. The query contract, coverage algebra, bucket alignment, move
         chain and value routing stay free of object-graph coupling, so a future generic engine can
         implement IHistoryStore without depending on the interceptor registry or on HomeBlaze. The one
         piece of eligibility that does need the graph lives in HomeBlaze.History. -->

</Project>
